---
// Brand mark: an arched doorway onto a hall of shelves, the brass star at its far door. Paths come from src/brand/marks.ts.
import { door, doorStar } from '../brand/marks'
---
<svg class="logo-mark" viewBox="11 15 78 78" aria-hidden="true" focusable="false"><path d={door} fill="currentColor" fill-rule="evenodd" /><path class="brass" d={doorStar} /></svg>
<style>
  .logo-mark { width: 1.3em; height: 1.3em; vertical-align: -0.25em; margin-right: 0.35em; }
  .brass { fill: var(--brass); }
</style>
