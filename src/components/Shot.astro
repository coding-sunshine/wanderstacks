---
import type { Photo } from '../site/data'
interface Props { p: Photo; sizes?: string; eager?: boolean; name?: string }
const { p, sizes = '100vw', eager = false, name } = Astro.props
---
<img
  src={`${p.f}-960.webp`} srcset={`${p.f}-960.webp 960w, ${p.f}-1920.webp 1920w`} sizes={sizes}
  width={p.w} height={p.h} alt={p.cap} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}
  decoding="async" style={name ? `view-transition-name:${name}` : undefined}
/>
