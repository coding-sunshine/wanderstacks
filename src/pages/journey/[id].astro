---
import Base from '../../layouts/Base.astro'
import Dispersal from '../../components/Dispersal.astro'
import BookRows from '../../components/BookRows.astro'
import Shot from '../../components/Shot.astro'
import Credit from '../../components/Credit.astro'
import { booksOf, lead, libById, lost, year } from '../../site/data'
import { hasDispersal, holdersOf } from '../../site/dispersal'
import { eventsFor } from '../../site/record'

export const getStaticPaths = () => [...libById.values()].filter((l) => hasDispersal(l.id)).map((l) => ({ params: { id: l.id }, props: { l } }))
const { l } = Astro.props
const p = lead(l.id)
const holders = holdersOf(l.id)
const books = booksOf(l.id)
const events = eventsFor(l.id)
const readable = holders.filter((h) => h.manifest)
---
<Base title={`Follow the collection: ${l.n}`} desc={`Follow the surviving books of ${l.n} from the original library to the institutions that hold them today, then compare their digitized pages.`} index>
  <article class="journey">
    <header class="wrap sec head">
      <p class="kicker">Follow the collection</p>
      <h1>{l.n}, then and now</h1>
      <p class="lede">Start at the original library, follow the surviving objects to their present holders, and open their digitized pages side by side. Every transition stays attached to its source.</p>
      <nav class="steps" aria-label="Journey sections">
        <a href="#origin">1 · The original library</a>
        <a href="#dispersal">2 · Where the books went</a>
        <a href="#holders">3 · The present holders</a>
        <a href="#reading">4 · The reading desk</a>
      </nav>
    </header>

    <section class="wrap sec origin" id="origin">
      <div>
        <p class="step">01 · Origin</p>
        <h2>The original library</h2>
        <p>{l.st ?? `${l.n}, ${l.p}. ${l.yl || year(l.y)}.`}</p>
        <p><a class="pick" href={`/libraries/${l.id}/#walk`}>Enter the library record and any real or reconstructed views</a></p>
      </div>
      {p && <figure><Shot p={p} sizes="(max-width: 800px) 100vw, 42vw" name={`journey-${l.id}`} /><Credit p={p} /></figure>}
    </section>

    {events.length > 0 && (
      <section class="wrap sec history">
        <h2>What happened here</h2>
        <ol>
          {events.map((event) => <li><span class="year">{event.year == null ? 'Undated' : event.year < 0 ? `${-event.year} BC` : event.year}</span><span>{event.label} · <a href={event.source}>source</a></span></li>)}
        </ol>
      </section>
    )}

    <div data-pagefind-ignore><Dispersal lib={l.id} /></div>

    <section class="wrap sec holders" id="holders">
      <p class="step">03 · Survival</p>
      <h2>The present holders</h2>
      <ol>
        {holders.map((holder) => (
          <li>
            <b>{holder.holder}</b>
            <span>{holder.place}</span>
            <p>{holder.what}{holder.count != null && `, ${holder.count.toLocaleString('en')} items`}.</p>
            <p class="meta"><span class="stamp" data-s={holder.tier}>{holder.tier}</span> <a href={holder.source}>Evidence</a>{holder.manifest ? <a href={holder.manifest}>IIIF manifest</a> : <span class="dim">IIIF manifest still needed</span>}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap sec reading" id="reading">
      <p class="step">04 · Comparison</p>
      <h2>One desk, many surviving copies</h2>
      <p>Choose two holders, then turn their pages together. The desk reads IIIF v2 and v3 manifests cached at build time; images still come from the holding institutions.</p>
      {readable.length >= 2
        ? <p><a class="desk-link" href={`/desk/${l.id}/`}>Open the reading desk with {readable.length} holders</a></p>
        : <p class="dim">Two readable holder manifests are required for comparison. Verified manifests currently available: {readable.length}.</p>}
      {books.length > 0 && <BookRows books={books} holder={false} />}
    </section>
  </article>
</Base>
<style>
  .head h1 { max-width: 15ch; }
  .steps { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; margin-top: 2rem; font: 0.8rem var(--mono); }
  .steps a { text-decoration: underline; text-underline-offset: 0.25em; }
  .origin { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .origin figure { margin: 0; }
  .origin img { width: 100%; max-height: 65vh; object-fit: cover; }
  .step { color: var(--brass); font: 0.75rem var(--mono); text-transform: uppercase; letter-spacing: 0.1em; }
  .history ol { list-style: none; padding: 0; }
  .history li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding-block: 0.7rem; border-top: 1px solid var(--rule); }
  .year { color: var(--brass); font-variant-numeric: tabular-nums; }
  .holders ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .holders li { background: var(--stacks); padding: 1rem; }
  .holders li > span { display: block; color: var(--dim); margin-top: 0.3rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.7rem; font: 0.75rem var(--mono); }
  .reading { border-top: 1px solid var(--rule); }
  .reading > p { max-width: 68ch; }
  .desk-link { display: inline-block; margin-block: 1rem 2rem; padding: 0.9rem 1.4rem; background: var(--brass); color: var(--stacks); text-decoration: none; font: 1.25rem var(--display); }
  .desk-link:hover { background: var(--paper); }
  @media (max-width: 800px) { .origin { grid-template-columns: 1fr; } .history li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
