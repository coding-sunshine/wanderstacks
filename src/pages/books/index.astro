---
import Base from '../../layouts/Base.astro'
import BookRows from '../../components/BookRows.astro'
import Save from '../../components/Save.astro'
import { books, readHere, libs, booksOf, letter, sortKey } from '../../site/data'
const by = (a: { title: string }, b: { title: string }) => sortKey(a.title).localeCompare(sortKey(b.title))
const open = books.filter((b) => readHere(b.id)).sort(by)
// The full catalogue is too long for one page once ingested; the letter pages carry it.
const shown = books.length > 600 ? open : [...books].sort(by)
const letters = [...new Set(books.map((b) => letter(b.title)))].sort()
const shelves = libs.map((l) => ({ l, n: booksOf(l.id).length })).filter((x) => x.n).sort((a, b) => b.n - a.n)
---
<Base title="Books" desc={`${books.length} books tied to the great libraries. ${open.length} can be read here without leaving the site.`}>
  <section class="wrap sec">
    <h1>Books</h1>
    <p class="dim lede">{books.length} books and manuscripts tied to these libraries. {open.length} open here, page by page.</p>
    <nav class="picks az" aria-label="By first letter">{letters.map((c) => <a class="pick" href={`/books/by/${c === '#' ? '0' : c.toLowerCase()}/`}>{c}</a>)}</nav>
    <div class="tools">
      <input class="field" id="q" type="search" placeholder="Filter by title, author or library" aria-label="Filter books" />
      <div class="picks"><button class="pick" id="here" aria-pressed="false">Only books I can read here</button></div>
    </div>
    <div id="list"><BookRows books={shown} /></div>
    <p id="none" class="dim" hidden>No book matches. <a href="/search/">Search everything</a> instead.</p>
  </section>
  <section class="wrap sec">
    <h2>Saved for offline</h2>
    <Save kind="shelf" />
  </section>
  <section class="wrap sec">
    <h2>By library</h2>
    <ul class="shelves">{shelves.map(({ l, n }) => <li><a href={`/libraries/${l.id}/#books`}>{l.n}</a> <span class="dim">{n}</span></li>)}</ul>
  </section>
</Base>
<style>
  .lede { font-size: 1.3rem; margin-top: 1rem; }
  .az { margin: 1.6rem 0 0; }
  .az a { text-decoration: none; min-width: 2.4rem; text-align: center; }
  .tools { display: grid; gap: 0.9rem; margin: 1.6rem 0 1.4rem; }
  #q { max-width: 34rem; }
  .shelves { list-style: none; padding: 0; margin: 0; columns: 3 18rem; column-gap: 2.5rem; }
  .shelves li { padding: 0.3rem 0; break-inside: avoid; }
</style>
<script>
  const items = [...document.querySelectorAll<HTMLElement>('#list li')]
  const q = document.getElementById('q') as HTMLInputElement
  const here = document.getElementById('here')!
  const none = document.getElementById('none')!
  const apply = () => {
    const s = q.value.trim().toLowerCase(), only = here.getAttribute('aria-pressed') === 'true'
    let n = 0
    for (const li of items) {
      const on = (!s || li.dataset.q!.includes(s)) && (!only || !!li.querySelector('[data-s="open"]'))
      li.hidden = !on
      if (on) n++
    }
    none.hidden = n > 0
  }
  q.addEventListener('input', apply)
  here.addEventListener('click', () => { here.setAttribute('aria-pressed', String(here.getAttribute('aria-pressed') !== 'true')); apply() })
</script>
