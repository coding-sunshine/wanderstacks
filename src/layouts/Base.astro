---
import '../site/site.css'
import Mark from '../components/Mark.astro'
import Display from '../components/Display.astro'
// Same files the stylesheet loads; preloading them stops the headings and body from repainting in a fallback face.
import caslon from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url'
import garamond from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url'
interface Props { title: string; desc?: string; index?: boolean; image?: string }
const { title, desc = "Walk the world's great libraries, standing and lost, and read their books.", index = false, image } = Astro.props
const at = Astro.url.pathname
const url = new URL(at, Astro.site).href
const full = title === 'Wanderstacks' ? title : `${title} | Wanderstacks`
const nav = [['/libraries/', 'Libraries'], ['/books/', 'Books'], ['/visit/', 'Visit'], ['/atlas/', 'Globe'], ['/shelf/', 'Shelf'], ['/search/', 'Search']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <Display />
    <title>{full}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content="Wanderstacks" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image ?? '/og.jpg', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[caslon, garamond].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href="/"><Mark />Wanderstacks</a>
      {nav.map(([href, label]) => <a href={href} aria-current={at.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </header>
    <main id="main" {...(index ? { 'data-pagefind-body': '' } : {})}><slot /></main>
    <footer class="foot">
      <p>Every photograph, panorama and scan carries its author and licence beside it.</p>
      <p><a href="/libraries/">All libraries</a></p>
      <p><a href="/books/">All books</a></p>
      <p><a href="/calendar/">Calendar</a></p>
      <p><a href="/data/">Open data</a></p>
      <p><a href="/display/">Display settings</a></p>
    </footer>
  </body>
</html>
